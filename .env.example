# ==========================================
# HARA WORKSHOP - ENVIRONMENT CONFIGURATION
# ==========================================

# Django Configuration
DEBUG=True
SECRET_KEY=replace-with-random-64-char-django-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL for Docker/Prod or SQLite fallback locally)
POSTGRES_DB=hara_workshop_db
POSTGRES_USER=hara_user
POSTGRES_PASSWORD=replace-with-strong-db-password
# Set to PostgreSQL connection string for Postgres:
# DATABASE_URL=postgresql://hara_user:replace-with-strong-db-password@localhost:5432/hara_workshop_db
# If DATABASE_URL is not set or begins with sqlite, SQLite is used (DEBUG=True only).
DATABASE_URL=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT Configuration
JWT_SECRET=replace-with-random-64-char-jwt-signing-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# If Redis is unavailable, Celery falls back to eager synchronous execution:
CELERY_TASK_ALWAYS_EAGER=False

# Media Storage Configuration
MEDIA_ROOT=media
MEDIA_URL=/media/

# Business Defaults
WORKSHOP_NAME=Hara Workshop
WORKSHOP_TAGLINE=Metal and Wood Solution
WORKSHOP_PHONE=+251926629999
WORKSHOP_EMAIL=info@haraworkshop.com
WORKSHOP_TELEGRAM=@haraworkshop
WORKSHOP_LOCATION=Addis Ababa, Bole Arabsa, Water Tanker
DEFAULT_CURRENCY=ETB
DEFAULT_TAX_RATE=15.0

# Notification Providers (Abstracted)
# Supported: dummy, smtp, twilio, telegram
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
NOTIFICATION_PROVIDER=dummy
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=HaraWorkshopOrdersBot
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHAT_ID=
SMS_PROVIDER_API_KEY=
