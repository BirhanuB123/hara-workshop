# Neon (use the pooled connection string for the API)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Only for `npm run db:copy`: the CURRENT Django Postgres database (read-only use)
SOURCE_DATABASE_URL=

PORT=8000
NODE_ENV=development
# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,https://hara-workshop.vercel.app
# Public API base, used to build absolute URLs (no trailing slash)
PUBLIC_API_URL=http://localhost:8000

JWT_ACCESS_SECRET=change-me-long-random
JWT_REFRESH_SECRET=change-me-another-long-random

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=HaraWorkshopOrdersBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_MANAGER_CHAT_ID=

# Same defaults as Django (DRF_THROTTLE_*)
THROTTLE_CONTACT_PER_HOUR=10
THROTTLE_QUOTE_PER_HOUR=10
