// Generated from the Django models (apps/*/models.py). Table and column names match the
// current database, so `npm run db:copy` can move data across without renaming anything.
// After `prisma db pull` against your live Django DB, diff this file to confirm there is no drift.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                String                 @id @default(uuid()) @db.Uuid
  created_at                        DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  password                          String                 @db.VarChar(128)
  last_login                        DateTime?              @db.Timestamptz(6)
  is_superuser                      Boolean                @default(false)
  email                             String                 @unique @db.VarChar(254)
  first_name                        String                 @db.VarChar(150)
  last_name                         String                 @db.VarChar(150)
  phone_number                      String?                @unique @db.VarChar(30)
  role                              String                 @default("CUSTOMER") @db.VarChar(30)
  avatar                            String?                @db.VarChar(500)
  is_active                         Boolean                @default(true)
  is_staff                          Boolean                @default(false)
  customer_profile                  CustomerProfile?       @relation("CustomerProfile_user")
  employee_profile                  EmployeeProfile?       @relation("EmployeeProfile_user")
  audit_logs                        AuditLog[]             @relation("AuditLog_user")
  quotes                            Quote[]                @relation("Quote_customer")
  orders                            Order[]                @relation("Order_customer")
  supervised_jobs                   ProductionJob[]        @relation("ProductionJob_supervisor")
  assigned_tasks                    ProductionTask[]       @relation("ProductionTask_assigned_to")
  productionlog_updated_by          ProductionLog[]        @relation("ProductionLog_updated_by")
  inventorytransaction_performed_by InventoryTransaction[] @relation("InventoryTransaction_performed_by")
  conversations                     Conversation[]         @relation("Conversation_customer")
  sent_messages                     Message[]              @relation("Message_sender")
  notifications                     Notification[]         @relation("Notification_user")

  @@index([role])
  @@map("accounts_user")
}

model CustomerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user_id      String   @unique @db.Uuid
  user         User     @relation("CustomerProfile_user", fields: [user_id], references: [id], onDelete: Cascade)
  address      String?  @db.VarChar(255)
  city         String   @default("Addis Ababa") @db.VarChar(100)
  company_name String?  @db.VarChar(200)
  tin_number   String?  @db.VarChar(50)
  notes        String?

  @@map("accounts_customerprofile")
}

model EmployeeProfile {
  id                String    @id @default(uuid()) @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user_id           String    @unique @db.Uuid
  user              User      @relation("EmployeeProfile_user", fields: [user_id], references: [id], onDelete: Cascade)
  department        String?   @db.VarChar(100)
  job_title         String?   @db.VarChar(100)
  hire_date         DateTime? @db.Date
  emergency_contact String?   @db.VarChar(100)
  skills            String?

  @@map("accounts_employeeprofile")
}

model WorkshopSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  name                String   @default("Hara Workshop") @db.VarChar(255)
  tagline             String   @default("Metal and Wood Solution") @db.VarChar(255)
  phone               String   @default("+251926629999") @db.VarChar(50)
  email               String   @default("info@haraworkshop.com") @db.VarChar(254)
  telegram            String   @default("@haraworkshop") @db.VarChar(100)
  address             String   @default("Addis Ababa, Bole Arabsa, Water Tanker") @db.VarChar(255)
  address_amharic     String   @default("አዲስ አበባ ቦሌ አራብሳ ውሃ ታንከር") @db.VarChar(255)
  working_hours       String   @default("Mon - Sat: 8:00 AM - 6:00 PM") @db.VarChar(255)
  currency            String   @default("ETB") @db.VarChar(10)
  vat_percentage      Decimal  @default(15.0) @db.Decimal(5, 2)
  quote_validity_days Int      @default(15)
  logo                String?  @db.VarChar(500)

  @@map("core_workshopsettings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user_id     String?  @db.Uuid
  user        User?    @relation("AuditLog_user", fields: [user_id], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(50)
  resource    String   @db.VarChar(100)
  resource_id String?  @db.VarChar(100)
  ip_address  String?  @db.Inet
  metadata    Json     @default("{}") @db.JsonB

  @@index([user_id])
  @@map("core_auditlog")
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  name           String    @unique @db.VarChar(100)
  name_am        String    @default("") @db.VarChar(100)
  slug           String    @unique @db.VarChar(120)
  description    String?
  description_am String    @default("")
  image          String?   @db.VarChar(500)
  is_active      Boolean   @default(true)
  products       Product[] @relation("Product_category")

  @@map("products_category")
}

model Product {
  id                        String         @id @default(uuid()) @db.Uuid
  created_at                DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  name                      String         @db.VarChar(200)
  name_am                   String         @default("") @db.VarChar(200)
  slug                      String?        @db.VarChar(220)
  sku                       String         @unique @db.VarChar(50)
  service_category          String         @default("METAL_WORKS") @db.VarChar(50)
  service_id                String?        @db.Uuid
  service                   Service?       @relation("Product_service", fields: [service_id], references: [id], onDelete: SetNull)
  category_id               String?        @db.Uuid
  category                  Category?      @relation("Product_category", fields: [category_id], references: [id], onDelete: Restrict)
  product_type              String         @default("") @db.VarChar(100)
  subcategory               String         @default("") @db.VarChar(100)
  subcategory_am            String         @default("") @db.VarChar(100)
  short_description         String         @default("") @db.VarChar(350)
  short_description_am      String         @default("") @db.VarChar(350)
  description               String
  description_am            String         @default("")
  detailed_description      String         @default("")
  material                  String         @db.VarChar(200)
  material_am               String         @default("") @db.VarChar(200)
  metal_materials           String         @default("") @db.VarChar(255)
  wood_materials            String         @default("") @db.VarChar(255)
  finish_options            String         @default("") @db.VarChar(255)
  applications              String         @default("") @db.VarChar(255)
  customization_options     String         @default("")
  estimated_production_time String         @default("1-3 weeks") @db.VarChar(100)
  dimensions_length         Decimal?       @db.Decimal(8, 2)
  dimensions_width          Decimal?       @db.Decimal(8, 2)
  dimensions_height         Decimal?       @db.Decimal(8, 2)
  dimensions_unit           String         @default("cm") @db.VarChar(10)
  starting_price            Decimal        @default(0) @db.Decimal(12, 2)
  unit                      String         @default("piece") @db.VarChar(30)
  is_featured               Boolean        @default(false)
  is_active                 Boolean        @default(true)
  stock_status              String         @default("MADE_TO_ORDER") @db.VarChar(20)
  is_customizable           Boolean        @default(true)
  images                    ProductImage[] @relation("ProductImage_product")
  quotes                    Quote[]        @relation("Quote_product")
  orderitem_product         OrderItem[]    @relation("OrderItem_product")

  @@index([slug])
  @@index([service_category])
  @@index([service_id])
  @@index([category_id])
  @@index([subcategory])
  @@map("products_product")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  product_id String   @db.Uuid
  product    Product  @relation("ProductImage_product", fields: [product_id], references: [id], onDelete: Cascade)
  image      String   @db.VarChar(500)
  is_primary Boolean  @default(false)
  caption    String?  @db.VarChar(150)

  @@index([product_id])
  @@map("products_productimage")
}

model ServiceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  name        String    @unique @db.VarChar(100)
  name_am     String    @default("") @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?
  services    Service[] @relation("Service_category")

  @@map("services_servicecategory")
}

model Service {
  id                   String          @id @default(uuid()) @db.Uuid
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  category_id          String          @db.Uuid
  category             ServiceCategory @relation("Service_category", fields: [category_id], references: [id], onDelete: Cascade)
  title                String          @db.VarChar(200)
  title_am             String          @default("") @db.VarChar(200)
  slug                 String          @unique @db.VarChar(220)
  tagline              String          @default("") @db.VarChar(255)
  tagline_am           String          @default("") @db.VarChar(255)
  short_description    String          @db.VarChar(300)
  short_description_am String          @default("") @db.VarChar(300)
  full_description     String
  full_description_am  String          @default("")
  starting_price       Decimal?        @db.Decimal(12, 2)
  price_unit           String          @default("per project") @db.VarChar(50)
  turnaround_time      String          @default("1-2 weeks") @db.VarChar(100)
  is_active            Boolean         @default(true)
  image                String?         @db.VarChar(500)
  offerings            Json            @default("[]") @db.JsonB
  applications         Json            @default("[]") @db.JsonB
  materials            Json            @default("[]") @db.JsonB
  benefits             Json            @default("[]") @db.JsonB
  process_steps        Json            @default("[]") @db.JsonB
  customization_info   String          @default("")
  products             Product[]       @relation("Product_service")
  gallery_images       ServiceImage[]  @relation("ServiceImage_service")

  @@index([category_id])
  @@map("services_service")
}

model ServiceImage {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  service_id  String   @db.Uuid
  service     Service  @relation("ServiceImage_service", fields: [service_id], references: [id], onDelete: Cascade)
  image       String   @db.VarChar(500)
  caption     String?  @db.VarChar(200)
  description String   @default("")
  order       Int      @default(0)
  is_primary  Boolean  @default(false)

  @@index([service_id])
  @@map("services_serviceimage")
}

model Project {
  id              String         @id @default(uuid()) @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  title           String         @db.VarChar(200)
  slug            String         @unique @db.VarChar(220)
  category        String         @default("CUSTOM") @db.VarChar(30)
  description     String
  client_type     String         @default("RESIDENTIAL") @db.VarChar(30)
  materials_used  String         @db.VarChar(255)
  completion_date DateTime?      @db.Date
  is_featured     Boolean        @default(false)
  is_published    Boolean        @default(true)
  images          ProjectImage[] @relation("ProjectImage_project")

  @@map("projects_project")
}

model ProjectImage {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  project_id String   @db.Uuid
  project    Project  @relation("ProjectImage_project", fields: [project_id], references: [id], onDelete: Cascade)
  image      String   @db.VarChar(500)
  image_type String   @default("REGULAR") @db.VarChar(20)
  caption    String?  @db.VarChar(150)

  @@index([project_id])
  @@map("projects_projectimage")
}

model Quote {
  id                            String              @id @default(uuid()) @db.Uuid
  created_at                    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  quote_number                  String              @unique @db.VarChar(50)
  customer_id                   String?             @db.Uuid
  customer                      User?               @relation("Quote_customer", fields: [customer_id], references: [id], onDelete: SetNull)
  customer_name                 String              @default("") @db.VarChar(200)
  customer_phone                String              @default("") @db.VarChar(50)
  customer_email                String              @default("") @db.VarChar(254)
  product_id                    String?             @db.Uuid
  product                       Product?            @relation("Quote_product", fields: [product_id], references: [id], onDelete: SetNull)
  product_code                  String              @default("") @db.VarChar(100)
  product_name                  String              @default("") @db.VarChar(200)
  product_category              String              @default("") @db.VarChar(100)
  product_image_url             String              @default("") @db.VarChar(500)
  project_title                 String              @db.VarChar(200)
  service_type                  String              @db.VarChar(100)
  description                   String
  material_preference           String?             @db.VarChar(200)
  width_cm                      Decimal?            @db.Decimal(8, 2)
  height_cm                     Decimal?            @db.Decimal(8, 2)
  length_cm                     Decimal?            @db.Decimal(8, 2)
  quantity                      Int                 @default(1)
  calculated_volume_m3          Decimal?            @db.Decimal(10, 4)
  estimated_baseline_amount     Decimal?            @db.Decimal(12, 2)
  preferred_completion_date     DateTime?           @db.Date
  installation_required         Boolean             @default(false)
  delivery_required             Boolean             @default(true)
  delivery_address              String?             @db.VarChar(255)
  site_location                 String              @default("") @db.VarChar(255)
  status                        String              @default("SUBMITTED") @db.VarChar(30)
  materials_cost                Decimal             @default(0.00) @db.Decimal(12, 2)
  labor_cost                    Decimal             @default(0.00) @db.Decimal(12, 2)
  transportation_cost           Decimal             @default(0.00) @db.Decimal(12, 2)
  installation_cost             Decimal             @default(0.00) @db.Decimal(12, 2)
  additional_charges            Decimal             @default(0.00) @db.Decimal(12, 2)
  discount                      Decimal             @default(0.00) @db.Decimal(12, 2)
  subtotal                      Decimal             @default(0.00) @db.Decimal(12, 2)
  total_amount                  Decimal             @default(0.00) @db.Decimal(12, 2)
  expiration_date               DateTime?           @db.Date
  workshop_notes                String?
  customer_notes                String?
  telegram_chat_id              String              @default("") @db.VarChar(50)
  telegram_link_token           String              @default("") @db.VarChar(64)
  telegram_token_expires_at     DateTime?           @db.Timestamptz(6)
  telegram_linked_at            DateTime?           @db.Timestamptz(6)
  telegram_last_notified_status String              @default("") @db.VarChar(50)
  items                         QuoteItem[]         @relation("QuoteItem_quote")
  attachments                   QuoteAttachment[]   @relation("QuoteAttachment_quote")
  telegram_links                TelegramOrderLink[] @relation("TelegramOrderLink_quote")
  order                         Order?              @relation("Order_quote")
  conversations                 Conversation[]      @relation("Conversation_quotation")

  @@index([customer_id])
  @@index([product_id])
  @@index([status])
  @@index([telegram_chat_id])
  @@index([telegram_link_token])
  @@map("quotations_quote")
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  quote_id    String   @db.Uuid
  quote       Quote    @relation("QuoteItem_quote", fields: [quote_id], references: [id], onDelete: Cascade)
  description String   @db.VarChar(255)
  quantity    Int      @default(1)
  unit_cost   Decimal  @default(0.00) @db.Decimal(12, 2)
  total_cost  Decimal  @default(0.00) @db.Decimal(12, 2)

  @@index([quote_id])
  @@map("quotations_quoteitem")
}

model QuoteAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  quote_id   String   @db.Uuid
  quote      Quote    @relation("QuoteAttachment_quote", fields: [quote_id], references: [id], onDelete: Cascade)
  file       String   @db.VarChar(500)
  file_name  String   @db.VarChar(255)

  @@index([quote_id])
  @@map("quotations_quoteattachment")
}

model TelegramOrderLink {
  id                  String    @id @default(uuid()) @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  quote_id            String?   @db.Uuid
  quote               Quote?    @relation("TelegramOrderLink_quote", fields: [quote_id], references: [id], onDelete: Cascade)
  order_id            String?   @db.Uuid
  order               Order?    @relation("TelegramOrderLink_order", fields: [order_id], references: [id], onDelete: Cascade)
  token               String    @unique @db.VarChar(64)
  is_used             Boolean   @default(false)
  expires_at          DateTime  @db.Timestamptz(6)
  telegram_user_id    String    @default("") @db.VarChar(50)
  telegram_username   String    @default("") @db.VarChar(100)
  telegram_first_name String    @default("") @db.VarChar(100)
  linked_at           DateTime? @db.Timestamptz(6)

  @@index([quote_id])
  @@index([order_id])
  @@index([telegram_user_id])
  @@map("quotations_telegramorderlink")
}

model Order {
  id                            String              @id @default(uuid()) @db.Uuid
  created_at                    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  order_number                  String              @unique @db.VarChar(50)
  quote_id                      String?             @unique @db.Uuid
  quote                         Quote?              @relation("Order_quote", fields: [quote_id], references: [id], onDelete: SetNull)
  customer_id                   String?             @db.Uuid
  customer                      User?               @relation("Order_customer", fields: [customer_id], references: [id], onDelete: SetNull)
  customer_name                 String              @default("") @db.VarChar(200)
  customer_phone                String              @default("") @db.VarChar(50)
  customer_email                String              @default("") @db.VarChar(254)
  status                        String              @default("PENDING") @db.VarChar(30)
  total_amount                  Decimal             @default(0.0) @db.Decimal(12, 2)
  paid_amount                   Decimal             @default(0.0) @db.Decimal(12, 2)
  delivery_address              String?             @db.VarChar(255)
  delivery_city                 String              @default("Addis Ababa") @db.VarChar(100)
  expected_delivery_date        DateTime?           @db.Date
  notes                         String?
  telegram_chat_id              String              @default("") @db.VarChar(50)
  telegram_linked_at            DateTime?           @db.Timestamptz(6)
  telegram_last_notified_status String              @default("") @db.VarChar(50)
  telegram_links                TelegramOrderLink[] @relation("TelegramOrderLink_order")
  items                         OrderItem[]         @relation("OrderItem_order")
  production_job                ProductionJob?      @relation("ProductionJob_order")
  conversations                 Conversation[]      @relation("Conversation_order")

  @@index([customer_id])
  @@index([status])
  @@index([telegram_chat_id])
  @@map("orders_order")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  order_id    String   @db.Uuid
  order       Order    @relation("OrderItem_order", fields: [order_id], references: [id], onDelete: Cascade)
  product_id  String?  @db.Uuid
  product     Product? @relation("OrderItem_product", fields: [product_id], references: [id], onDelete: SetNull)
  item_title  String   @db.VarChar(200)
  description String?
  quantity    Int      @default(1)
  unit_price  Decimal  @default(0.0) @db.Decimal(12, 2)
  total_price Decimal  @default(0.0) @db.Decimal(12, 2)

  @@index([order_id])
  @@index([product_id])
  @@map("orders_orderitem")
}

model ProductionJob {
  id                  String           @id @default(uuid()) @db.Uuid
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  order_id            String           @unique @db.Uuid
  order               Order            @relation("ProductionJob_order", fields: [order_id], references: [id], onDelete: Cascade)
  job_code            String           @unique @db.VarChar(50)
  stage               String           @default("ORDER_CONFIRMED") @db.VarChar(50)
  priority            String           @default("MEDIUM") @db.VarChar(20)
  progress_percentage Int              @default(0)
  supervisor_id       String?          @db.Uuid
  supervisor          User?            @relation("ProductionJob_supervisor", fields: [supervisor_id], references: [id], onDelete: SetNull)
  start_date          DateTime?        @db.Date
  expected_completion DateTime?        @db.Date
  actual_completion   DateTime?        @db.Date
  notes               String?
  tasks               ProductionTask[] @relation("ProductionTask_job")
  logs                ProductionLog[]  @relation("ProductionLog_job")

  @@index([stage])
  @@index([supervisor_id])
  @@map("production_productionjob")
}

model ProductionTask {
  id             String        @id @default(uuid()) @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  job_id         String        @db.Uuid
  job            ProductionJob @relation("ProductionTask_job", fields: [job_id], references: [id], onDelete: Cascade)
  title          String        @db.VarChar(200)
  stage          String        @db.VarChar(50)
  assigned_to_id String?       @db.Uuid
  assigned_to    User?         @relation("ProductionTask_assigned_to", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  is_completed   Boolean       @default(false)
  notes          String?

  @@index([job_id])
  @@index([assigned_to_id])
  @@map("production_productiontask")
}

model ProductionLog {
  id                  String        @id @default(uuid()) @db.Uuid
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  updated_at          DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  job_id              String        @db.Uuid
  job                 ProductionJob @relation("ProductionLog_job", fields: [job_id], references: [id], onDelete: Cascade)
  previous_stage      String        @db.VarChar(50)
  new_stage           String        @db.VarChar(50)
  progress_percentage Int
  updated_by_id       String?       @db.Uuid
  updated_by          User?         @relation("ProductionLog_updated_by", fields: [updated_by_id], references: [id], onDelete: SetNull)
  notes               String?
  image               String?       @db.VarChar(500)

  @@index([job_id])
  @@index([updated_by_id])
  @@map("production_productionlog")
}

model Material {
  id            String                 @id @default(uuid()) @db.Uuid
  created_at    DateTime               @default(now()) @db.Timestamptz(6)
  updated_at    DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  sku           String                 @unique @db.VarChar(50)
  name          String                 @db.VarChar(200)
  category      String                 @default("STEEL") @db.VarChar(50)
  unit          String                 @default("PIECE") @db.VarChar(20)
  current_stock Decimal                @default(0.00) @db.Decimal(12, 2)
  minimum_stock Decimal                @default(5.00) @db.Decimal(12, 2)
  unit_cost     Decimal                @default(0.00) @db.Decimal(12, 2)
  supplier_id   String?                @db.Uuid
  supplier      Supplier?              @relation("Material_supplier", fields: [supplier_id], references: [id], onDelete: SetNull)
  location      String                 @default("Main Rack A") @db.VarChar(100)
  is_active     Boolean                @default(true)
  transactions  InventoryTransaction[] @relation("InventoryTransaction_material")

  @@index([supplier_id])
  @@map("inventory_material")
}

model InventoryTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  material_id      String   @db.Uuid
  material         Material @relation("InventoryTransaction_material", fields: [material_id], references: [id], onDelete: Cascade)
  transaction_type String   @db.VarChar(30)
  quantity         Decimal  @db.Decimal(12, 2)
  unit_cost        Decimal  @default(0.00) @db.Decimal(12, 2)
  total_cost       Decimal  @default(0.00) @db.Decimal(12, 2)
  performed_by_id  String?  @db.Uuid
  performed_by     User?    @relation("InventoryTransaction_performed_by", fields: [performed_by_id], references: [id], onDelete: SetNull)
  notes            String?  @db.VarChar(255)

  @@index([material_id])
  @@index([performed_by_id])
  @@map("inventory_inventorytransaction")
}

model Supplier {
  id                 String     @id @default(uuid()) @db.Uuid
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  updated_at         DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  name               String     @db.VarChar(200)
  contact_person     String?    @db.VarChar(150)
  phone              String     @db.VarChar(50)
  email              String?    @db.VarChar(254)
  address            String     @default("Addis Ababa") @db.VarChar(255)
  materials_supplied String     @db.VarChar(255)
  notes              String?
  is_active          Boolean    @default(true)
  materials          Material[] @relation("Material_supplier")

  @@map("suppliers_supplier")
}

model Conversation {
  id              String    @id @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  customer_id     String    @db.Uuid
  customer        User      @relation("Conversation_customer", fields: [customer_id], references: [id], onDelete: Cascade)
  subject         String    @default("General Workshop Inquiry") @db.VarChar(200)
  status          String    @default("OPEN") @db.VarChar(20)
  quotation_id    String?   @db.Uuid
  quotation       Quote?    @relation("Conversation_quotation", fields: [quotation_id], references: [id], onDelete: SetNull)
  order_id        String?   @db.Uuid
  order           Order?    @relation("Conversation_order", fields: [order_id], references: [id], onDelete: SetNull)
  last_message_at DateTime  @db.Timestamptz(6)
  messages        Message[] @relation("Message_conversation")

  @@index([customer_id])
  @@index([quotation_id])
  @@index([order_id])
  @@map("messaging_conversation")
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  conversation_id String       @db.Uuid
  conversation    Conversation @relation("Message_conversation", fields: [conversation_id], references: [id], onDelete: Cascade)
  sender_id       String       @db.Uuid
  sender          User         @relation("Message_sender", fields: [sender_id], references: [id], onDelete: Cascade)
  content         String
  attachment      String?      @db.VarChar(500)
  is_read         Boolean      @default(false)

  @@index([conversation_id])
  @@index([sender_id])
  @@map("messaging_message")
}

model Notification {
  id                String   @id @default(uuid()) @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user_id           String   @db.Uuid
  user              User     @relation("Notification_user", fields: [user_id], references: [id], onDelete: Cascade)
  title             String   @db.VarChar(200)
  message           String
  notification_type String   @default("SYSTEM") @db.VarChar(30)
  link_url          String?  @db.VarChar(255)
  is_read           Boolean  @default(false)

  @@index([user_id])
  @@map("notifications_notification")
}
